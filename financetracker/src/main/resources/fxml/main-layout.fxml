<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="frontend.controllers.MainController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root-container">

    <!-- ================= SIDEBAR ================= -->

    <left>
        <VBox spacing="20" styleClass="sidebar">
            <VBox spacing="5">
                <Label text="FinancePro" styleClass="logo-text"/>
                <Label text="Enterprise Tier" styleClass="subtitle"/>
            </VBox>

            <VBox spacing="10">
                <Button fx:id="dashboardBtn" text="Dashboard" styleClass="nav-button" onAction="#handleNavigation"/>
                <Button fx:id="addTransactionBtn" text="Add Transaction" styleClass="nav-button" onAction="#handleNavigation"/>
                <Button fx:id="historyBtn" text="History" styleClass="nav-button active" onAction="#handleNavigation"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>
            <Button text="+ New Report" styleClass="report-button"/>
        </VBox>
    </left>

    <!-- ================= TOPBAR ================= -->

    <top>
        <HBox spacing="20"
              alignment="CENTER_LEFT"
              styleClass="topbar">

            <!-- Title -->
            <Label text="Finance Tracker"
                   styleClass="top-title"/>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Search -->
            <TextField promptText="Search transactions..."
                       styleClass="search-field"/>

            <!-- Icons -->
            <Button text="🔔"
                    styleClass="icon-button"/>

            <Button text="⚙"
                    styleClass="icon-button"/>

            <!-- Profile -->
            <Label text="👤"
                   styleClass="profile-icon"/>

        </HBox>
    </top>

    <!-- ================= MAIN CONTENT ================= -->

    <center>
        <StackPane>

            <VBox fx:id="dashboardPage" visible="false" managed="false" styleClass="content-container" alignment="CENTER">
                <Label text="Dashboard View (Blank)" style="-fx-text-fill: white; -fx-font-size: 24px;"/>
            </VBox>

            <VBox fx:id="addTransactionPage" visible="false" managed="false" styleClass="content-container" alignment="CENTER">
                <Label text="Add Transaction View (Blank)" style="-fx-text-fill: white; -fx-font-size: 24px;"/>
            </VBox>

            <VBox fx:id="historyPage" visible="true" managed="true" spacing="25" styleClass="content-container">

                <BorderPane styleClass="header-box">
                    <left>
                        <VBox spacing="5" BorderPane.alignment="CENTER_LEFT">
                            <Label text="Transaction History"
                                styleClass="page-title"/>
                            <Label text="Review and filter your recent financial activities."
                                styleClass="page-subtitle"/>
                        </VBox>
                    </left>
                    <right>
                        <HBox spacing="10" alignment="BOTTOM_RIGHT" BorderPane.alignment="BOTTOM_RIGHT">
                            <padding>
                                <Insets bottom="5"/>
                            </padding>
                            <!-- fx:id ditambahkan agar bisa di-bind height-nya dari controller -->
                            <ComboBox fx:id="categoryFilter" promptText="All Categories"
                                    styleClass="filter-box"/>
                            <ComboBox fx:id="dateFilter" promptText="Last 30 Days"
                                    styleClass="filter-box"/>
                            <Button fx:id="exportButton" text="↓ Export"
                                    styleClass="export-button"/>
                        </HBox>
                    </right>
                </BorderPane>


                <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS" styleClass="transaction-table">
                    <columns>
                        <TableColumn fx:id="dateColumn"     text="DATE"     prefWidth="140" sortable="false"/>
                        <TableColumn fx:id="categoryColumn" text="CATEGORY" prefWidth="160" sortable="false"/>
                        <TableColumn fx:id="typeColumn"     text="TYPE"     prefWidth="160" sortable="false"/>
                        <TableColumn fx:id="notesColumn"    text="NOTES"    prefWidth="300" sortable="false"/>
                        <TableColumn fx:id="amountColumn"   text="AMOUNT"   prefWidth="170" sortable="false"/>
                    </columns>
                </TableView>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
