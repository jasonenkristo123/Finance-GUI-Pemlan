<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="frontend.controllers.MainController"
            styleClass="root-container">

    <!-- ================= SIDEBAR ================= -->

    <left>
        <VBox spacing="20" styleClass="sidebar">
            <VBox spacing="5">
                <Label text="FinancePro" styleClass="logo-text"/>
                <Label text="Enterprise Tier" styleClass="subtitle"/>
            </VBox>

            <VBox spacing="10">
                <Button fx:id="dashboardBtn" text="Dashboard" styleClass="nav-button" onAction="#handleNavigation"/>
                <Button fx:id="addTransactionBtn" text="Add Transaction" styleClass="nav-button" onAction="#handleNavigation"/>
                <Button fx:id="historyBtn" text="History" styleClass="nav-button" onAction="#handleNavigation"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- ================= TOPBAR ================= -->

    <top>
        <HBox spacing="20"
              alignment="CENTER_LEFT"
              styleClass="topbar">

            <!-- Title -->
            <Label text="Finance Tracker"
                   styleClass="top-title"/>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Search -->
            <TextField fx:id="searchField"
                       promptText="Search transactions..."
                       styleClass="search-field"/>

            <!-- Icons -->
            <Button text="🔔"
                    styleClass="icon-button"/>

            <Button text="⚙"
                    styleClass="icon-button"/>

            <!-- Profile -->
            <Label text="👤"
                    styleClass="profile-icon"/>

        </HBox>
    </top>

    <!-- ================= MAIN CONTENT ================= -->

    <center>
        <StackPane>
            <fx:include fx:id="dashboardPage" source="dashboard-page.fxml" visible="true" managed="true"/>
            <fx:include fx:id="addTransactionPage" source="add-transaction-page.fxml" visible="false" managed="false"/>
            <fx:include fx:id="historyPage" source="history-page.fxml" visible="false" managed="false"/>
        </StackPane>
    </center>

</BorderPane>
